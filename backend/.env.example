# Railway Configuration
# Variables d'environnement à configurer sur Railway.app

# Port (Railway le configure automatiquement)
PORT=8080

# PostgreSQL Database URL (Railway fournit DATABASE_URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/binetdb
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Logs
LOGGING_LEVEL_COM_BINET=INFO

# Pour utiliser PostgreSQL sur Railway (recommandé pour production):
# 1. Ajouter PostgreSQL dans Railway Dashboard
# 2. Railway créera automatiquement ces variables:
#    DATABASE_URL=postgresql://...
# 3. Décommenter et adapter:
# SPRING_DATASOURCE_URL=${DATABASE_URL}
# spring.datasource.driverClassName=org.postgresql.Driver
# spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Profile Spring (optionnel)
SPRING_PROFILES_ACTIVE=prod
